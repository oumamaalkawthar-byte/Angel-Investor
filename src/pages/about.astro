---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientBlob from '../components/GradientBlob.astro';

const principles = [
  { title: 'Founder-first', copy: 'Terms that respect the people building the company, not just the ones writing the check.' },
  { title: 'Speed over process', copy: 'Decisions in days, not committee cycles measured in months.' },
  { title: 'Long-term partner', copy: 'We stay involved from pre-seed through every follow-on round.' },
];
---

<BaseLayout title="About" description="Our investment thesis and philosophy.">
  <section class="relative overflow-hidden px-6 py-28">
    <GradientBlob class="opacity-60" />
    <div class="mx-auto max-w-4xl">
      <p data-reveal class="mb-4 font-mono text-xs uppercase tracking-[0.3em] text-accent">About</p>
      <h1 data-reveal class="font-display text-4xl font-semibold leading-tight sm:text-5xl">
        We back conviction, not consensus.
      </h1>
      <p data-reveal class="mt-6 max-w-2xl text-lg text-paper/70">
        We're an early-stage investor writing first checks into founders solving problems
        most people haven't noticed yet. Our thesis is simple: exceptional teams, unfair
        insight, and a market big enough to matter.
      </p>
    </div>
  </section>

  <section class="border-t border-line/60 bg-white/[0.02] px-6 py-28">
    <div class="mx-auto max-w-6xl">
      <h2 data-reveal class="mb-14 font-display text-3xl font-semibold sm:text-4xl">
        Investment Philosophy
      </h2>
      <div class="grid gap-10 md:grid-cols-3">
        {principles.map((principle, i) => (
          <div data-reveal>
            <span class="font-mono text-sm text-accent">0{i + 1}</span>
            <h3 class="mt-3 font-display text-xl font-semibold">{principle.title}</h3>
            <p class="mt-3 text-sm text-paper/60">{principle.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
