---
import BaseLayout from '../layouts/BaseLayout.astro';

const team: { name: string; role: string; bio: string }[] = [
  { name: 'Founding Partner', role: 'Investment Lead', bio: 'Adding team bios soon.' },
];
---

<BaseLayout title="Team" description="The people behind the fund.">
  <section class="px-6 py-28">
    <div class="mx-auto max-w-6xl">
      <p data-reveal class="mb-4 font-mono text-xs uppercase tracking-[0.3em] text-accent">Team</p>
      <h1 data-reveal class="font-display text-4xl font-semibold sm:text-5xl">
        The people behind the fund.
      </h1>
      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {team.map((member) => (
          <div data-reveal class="rounded-2xl border border-line/60 bg-white/[0.02] p-8">
            <div class="h-14 w-14 rounded-full bg-gradient-to-br from-accent to-cta"></div>
            <p class="mt-6 font-display text-lg font-semibold">{member.name}</p>
            <p class="mt-1 text-sm text-accent">{member.role}</p>
            <p class="mt-3 text-sm text-paper/60">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
