---
import BaseLayout from '../layouts/BaseLayout.astro';

const inputClass =
  'w-full rounded-lg border border-line/60 bg-white/[0.03] px-4 py-3 text-paper placeholder:text-paper/30 outline-none transition-colors focus:border-accent';
const labelClass = 'text-sm text-paper/70';
---

<BaseLayout title="Apply" description="Submit your startup for funding consideration.">
  <section class="px-6 py-28">
    <div class="mx-auto max-w-2xl">
      <p data-reveal class="mb-4 font-mono text-xs uppercase tracking-[0.3em] text-accent">Apply</p>
      <h1 data-reveal class="font-display text-4xl font-semibold sm:text-5xl">
        Apply for Funding
      </h1>
      <p data-reveal class="mt-4 text-paper/60">
        Five minutes. We read every application and reply within 48 hours.
      </p>

      <form method="post" data-reveal class="mt-12 space-y-6">
        <label class={`flex flex-col gap-2 ${labelClass}`}>
          Company Name
          <input type="text" name="company" required class={inputClass} />
        </label>
        <label class={`flex flex-col gap-2 ${labelClass}`}>
          Founder Name
          <input type="text" name="founder" required class={inputClass} />
        </label>
        <label class={`flex flex-col gap-2 ${labelClass}`}>
          Email
          <input type="email" name="email" required class={inputClass} />
        </label>
        <div class="grid gap-6 sm:grid-cols-2">
          <label class={`flex flex-col gap-2 ${labelClass}`}>
            Industry
            <input type="text" name="industry" required class={inputClass} />
          </label>
          <label class={`flex flex-col gap-2 ${labelClass}`}>
            Stage
            <select name="stage" class={inputClass}>
              <option value="idea">Idea</option>
              <option value="pre-seed">Pre-seed</option>
              <option value="seed">Seed</option>
              <option value="series-a">Series A</option>
            </select>
          </label>
        </div>
        <label class={`flex flex-col gap-2 ${labelClass}`}>
          Funding Ask
          <input type="text" name="funding_ask" class={inputClass} />
        </label>
        <label class={`flex flex-col gap-2 ${labelClass}`}>
          Pitch Deck Link
          <input type="url" name="pitch_deck" class={inputClass} />
        </label>
        <label class={`flex flex-col gap-2 ${labelClass}`}>
          Description
          <textarea name="description" required rows="5" class={inputClass}></textarea>
        </label>
        <button
          type="submit"
          data-magnetic
          class="inline-block rounded-full bg-cta px-8 py-4 font-medium text-ink transition-shadow hover:shadow-[0_0_40px_-8px_var(--color-cta)]"
        >
          Submit Application
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
