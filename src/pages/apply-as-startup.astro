---
import FormShell from '../components/forms/FormShell.astro';
const cities = ['Karachi','Lahore','Islamabad','Rawalpindi','Faisalabad','Peshawar','Multan','Other'];
const sectors = ['HealthTech','FinTech','EdTech','AgriTech','E-commerce','SaaS','CleanTech','Logistics','DeepTech / AI','Other'];
const steps = [
  { title:'Founder & contact', copy:'Who is building this, and how do we reach you?' },
  { title:'Startup basics', copy:'A focused view of the business and its current stage.' },
  { title:'Pitch & investment ask', copy:'The opportunity, the ask and what the capital unlocks.' },
  { title:'Review & declarations', copy:'Confirm the information before it enters screening.' },
];
---

<FormShell page="startup" title="Apply as Startup" eyebrow="Apply for investment" marker="04" markerLabel="FOCUSED STEPS" description="A focused application for founders ready to share the opportunity, answer serious questions and meet relevant investors." meta={[{value:'~10 min',label:'To complete'},{value:'4',label:'Focused steps'},{value:'5–7 days',label:'Initial screening'}]}>
  <Fragment slot="title">Build the pitch.<br />Enter the <em>right room.</em></Fragment>

  <section class="ai-form-content ai-startup-content" id="form-start">
    <div class="ai-wrap ai-startup-layout" data-form-view>
      <aside class="ai-step-rail">
        <div class="ai-progress-head"><span>APPLICATION</span><b data-current-step>01 / 04</b></div>
        <div class="ai-progress-line"><span data-progress-fill></span></div>
        <nav class="ai-step-nav" aria-label="Application steps">
          {steps.map((step,index) => <button type="button" data-step-target={index} data-title={step.title} data-copy={step.copy} class={index === 0 ? 'is-active' : ''}><span>{String(index+1).padStart(2,'0')}</span><div><strong>{step.title}</strong><small>{step.copy}</small></div></button>)}
        </nav>
        <div class="ai-rail-note"><small>YOUR DATA IS PROTECTED</small><p>Reviewed only by the SISL screening committee and backed by Al-Kawthar University.</p></div>
      </aside>

      <form class="ai-application ai-startup-form" id="startup-application-form" data-startup-form>
        <header class="ai-application-intro"><div><p class="ai-eyebrow">Step <span data-current-step>01 / 04</span></p><h2 data-step-title>Founder & contact</h2></div><span data-step-copy>Who is building this, and how do we reach you?</span></header>

        <section class="ai-step-panel is-active" data-step-panel="0">
          <div class="ai-section-heading"><span>01</span><div><small>Founder</small><h2>Who is leading the opportunity?</h2><p>Give the investment team a clear way to understand and reach the founding team.</p></div></div>
          <div class="ai-field-grid">
            <label class="ai-field"><span>Full name *</span><input name="founder_name" type="text" placeholder="e.g. Ahmed Raza" required /></label>
            <label class="ai-field"><span>Email address *</span><input name="founder_email" type="email" placeholder="name@company.com" required /></label>
            <label class="ai-field"><span>WhatsApp / phone *</span><input name="founder_phone" type="tel" placeholder="+92 3XX XXXXXXX" required /></label>
            <label class="ai-field"><span>City *</span><select name="founder_city" required><option value="" selected disabled>Select...</option>{cities.map(city => <option value={city}>{city}</option>)}</select></label>
            <label class="ai-field ai-wide"><span>Your role & short bio * <small>2–3 lines</small></span><textarea name="founder_bio" rows="4" placeholder="CEO — 6 yrs in logistics, previously ops lead at…" required></textarea></label>
            <label class="ai-field ai-wide"><span>LinkedIn or portfolio link <small>recommended</small></span><input name="founder_linkedin" type="url" placeholder="https://linkedin.com/in/…" /></label>
          </div>
          <div class="ai-cofounders"><div data-cofounder-list></div><button type="button" class="ai-add-cofounder" data-add-cofounder>+ Add a co-founder</button></div>
          <template id="cofounder-template"><div class="ai-cofounder-row"><span>CO-FOUNDER __INDEX__</span><input name="cofounder_name___INDEX__" placeholder="Name" /><input name="cofounder_role___INDEX__" placeholder="Role" /><input name="cofounder_linkedin___INDEX__" placeholder="LinkedIn" /></div></template>
        </section>

        <section class="ai-step-panel" data-step-panel="1" aria-hidden="true">
          <div class="ai-section-heading"><span>02</span><div><small>Startup basics</small><h2>Make the business easy to grasp.</h2><p>A concise description and clear stage signal help reviewers understand the opportunity quickly.</p></div></div>
          <div class="ai-field-grid">
            <label class="ai-field"><span>Startup name *</span><input name="startup_name" type="text" required /></label>
            <label class="ai-field"><span>Website / social <small>optional</small></span><input name="startup_website" type="url" placeholder="https://" /></label>
            <label class="ai-field ai-wide"><span>One-line description * <small>max 120 chars</small></span><input name="one_liner" type="text" maxlength="120" placeholder="We help X do Y using Z" required /></label>
          </div>
          <div class="ai-field ai-wide" data-choice-group><span>Sector *</span><input name="sector" type="hidden" required /><div class="ai-choice-pills">{sectors.map(sector => <button type="button" data-value={sector} aria-pressed="false">{sector}</button>)}</div></div>
          <div class="ai-field ai-wide" data-choice-group><span>Stage *</span><input name="stage" type="hidden" required /><div class="ai-choice-cards"><button type="button" data-value="Idea / MVP" aria-pressed="false"><span>Idea / MVP</span><small>Building, no revenue yet</small></button><button type="button" data-value="Early revenue" aria-pressed="false"><span>Early revenue</span><small>First paying customers</small></button><button type="button" data-value="Growth" aria-pressed="false"><span>Growth</span><small>Consistent revenue, scaling</small></button></div></div>
          <div class="ai-field-grid">
            <label class="ai-field"><span>Registration status *</span><select name="registration_status" required><option value="" selected disabled>Select...</option><option>Registered (SECP)</option><option>Sole proprietor</option><option>Not yet registered</option></select></label>
            <label class="ai-field"><span>Team size</span><select name="team_size"><option value="" selected disabled>Select...</option><option>1–5</option><option>6–10</option><option>11–25</option><option>25+</option></select></label>
          </div>
        </section>

        <section class="ai-step-panel" data-step-panel="2" aria-hidden="true">
          <div class="ai-section-heading"><span>03</span><div><small>Pitch & ask</small><h2>Show what the capital unlocks.</h2><p>Upload the core story, define the investment ask and connect the funds to clear priorities.</p></div></div>
          <div class="ai-field ai-wide"><span>Pitch deck *</span><label class="ai-file-drop"><input name="pitch_deck" type="file" accept="application/pdf" required /><span>↑</span><strong>Drop your pitch deck here, or click to browse</strong><small>PDF, max 15MB — must cover Problem · Solution · Market · Business model · Traction</small><small class="ai-file-name" data-file-name>No file selected</small></label></div>
          <div class="ai-field-grid">
            <label class="ai-field"><span>Investment required (PKR) *</span><select name="investment_ask" required><option value="" selected disabled>Select...</option><option>Under PKR 2.5M</option><option>PKR 2.5M – 5M</option><option>PKR 5M – 10M</option><option>PKR 10M – 25M</option><option>PKR 25M+</option></select></label>
            <label class="ai-field"><span>Equity offered *</span><select name="equity_offered" required><option value="" selected disabled>Select...</option><option>Under 5%</option><option>5% – 10%</option><option>10% – 15%</option><option>15% – 20%</option><option>20%+</option></select></label>
            <label class="ai-field ai-wide"><span>Use of funds * <small>top 3 items</small></span><textarea name="use_of_funds" rows="4" placeholder="e.g. 50% product, 30% marketing, 20% team" required></textarea></label>
            <label class="ai-field ai-wide"><span>Traction so far <small>revenue, users, LOIs</small></span><textarea name="traction" rows="4"></textarea></label>
          </div>
        </section>

        <section class="ai-step-panel" data-step-panel="3" aria-hidden="true">
          <div class="ai-section-heading"><span>04</span><div><small>Review</small><h2>One final confidence check.</h2><p>Confirm that the opportunity is authentic, ethical and ready for the SISL screening process.</p></div></div>
          <div class="ai-review"><div><span>✓</span><div><strong>Founder & contact</strong><small>Ready for review</small></div><button type="button" data-step-target="0">Edit</button></div><div><span>✓</span><div><strong>Startup basics</strong><small>Ready for review</small></div><button type="button" data-step-target="1">Edit</button></div><div><span>✓</span><div><strong>Pitch & investment ask</strong><small>Ready for review</small></div><button type="button" data-step-target="2">Edit</button></div></div>
          <div class="ai-declarations">
            <label class="ai-declaration"><input name="declaration_authentic" type="checkbox" required /><span><strong>Declaration of authenticity</strong><small>I confirm all information provided is true and accurate.</small></span></label>
            <label class="ai-declaration"><input name="declaration_ethical" type="checkbox" required /><span><strong>Ethical business declaration</strong><small>I confirm the business model is Halal and adheres to ethical standards.</small></span></label>
            <label class="ai-declaration"><input name="declaration_consent" type="checkbox" required /><span><strong>Consent to screening</strong><small>I agree that SISL's screening committee may review my application and contact me. <a href="/privacy-policy/">Privacy policy</a></small></span></label>
          </div>
        </section>

        <div class="ai-step-actions">
          <span data-step-action="0"></span><button type="button" class="ai-submit" data-next data-step-action="0">Continue <b>→</b></button>
          <button type="button" class="ai-back" data-back data-step-action="1" hidden>← Back</button><button type="button" class="ai-submit" data-next data-step-action="1" hidden>Continue <b>→</b></button>
          <button type="button" class="ai-back" data-back data-step-action="2" hidden>← Back</button><button type="button" class="ai-submit" data-next data-step-action="2" hidden>Continue <b>→</b></button>
          <button type="button" class="ai-back" data-back data-step-action="3" hidden>← Back</button><button type="submit" class="ai-submit" data-step-action="3" hidden>Submit application <b>↗</b></button>
        </div>
      </form>
    </div>

    <div class="ai-success" data-success-view hidden>
      <div class="ai-wrap">
        <div class="ai-success-card">
          <div class="ai-success-icon">✓</div>
          <h2>Application received</h2>
          <p>Reference no. <span class="ai-success-ref" data-ref-number></span> · Confirmation email sent. Our screening committee reviews applications every week — expect a response within 5–7 working days. Shortlisted startups will be asked for registration documents and financials at that stage.</p>
          <a href="/">Back to home</a>
        </div>
      </div>
    </div>
  </section>
</FormShell>
