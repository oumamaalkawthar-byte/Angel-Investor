---
import FormShell from '../components/forms/FormShell.astro';
const cities = ['Karachi','Lahore','Islamabad','Rawalpindi','Faisalabad','Peshawar','Multan','Overseas','Other'];
const sectors = ['FinTech','HealthTech','EdTech','AgriTech','E-commerce','SaaS','CleanTech','Logistics','DeepTech / AI','Any sector'];
---

<FormShell page="investor" title="Join as Investor" eyebrow="Join the network" marker="01" markerLabel="INVESTOR ACCESS" description="Meet pre-screened Pakistani startups in a focused environment built for informed conversations and serious investment decisions." meta={[{value:'5 min',label:'Focused application'},{value:'Private',label:'Investor access'},{value:'Curated',label:'Relevant deal flow'}]}>
  <Fragment slot="title">See better deals.<br />Back <em>bold ideas.</em></Fragment>

  <section class="ai-form-content" id="form-start">
    <div class="ai-wrap ai-form-layout" data-form-view>
      <aside class="ai-trust-rail">
        <p class="ai-eyebrow">Why this works</p>
        <article><span>01</span><div><strong>Curated deal flow</strong><p>Opportunities pass SISL's screening and mentorship pipeline before they reach the room.</p></div></article>
        <article><span>02</span><div><strong>Direct access</strong><p>Meet founders, ask the hard questions and negotiate directly—without passive listings.</p></div></article>
        <article><span>03</span><div><strong>Values aligned</strong><p>Explore businesses screened for responsible, ethical and Halal commercial models.</p></div></article>
      </aside>

      <form class="ai-application" id="investor-application-form">
        <header class="ai-application-intro"><div><p class="ai-eyebrow">Investor application</p><h2>Tell us how you invest.</h2></div><span>All information is confidential.</span></header>

        <section class="ai-form-section">
          <div class="ai-section-heading"><span>01</span><div><small>Contact</small><h2>Start with the essentials.</h2><p>Enough context for a short verification call and a relevant introduction.</p></div></div>
          <div class="ai-field-grid">
            <label class="ai-field"><span>Full name *</span><input name="investor_name" type="text" autocomplete="name" required /></label>
            <label class="ai-field"><span>Email *</span><input name="investor_email" type="email" autocomplete="email" required /></label>
            <label class="ai-field"><span>Phone / WhatsApp *</span><input name="investor_phone" type="tel" autocomplete="tel" required /></label>
            <label class="ai-field"><span>City *</span><select name="investor_city" required><option value="" selected disabled>Select...</option>{cities.map(city => <option value={city}>{city}</option>)}</select></label>
            <label class="ai-field"><span>Company / organization <small>optional</small></span><input name="investor_org" type="text" autocomplete="organization" /></label>
            <label class="ai-field"><span>LinkedIn profile <small>strongly recommended</small></span><input name="investor_linkedin" type="url" placeholder="https://linkedin.com/in/…" /></label>
          </div>
        </section>

        <section class="ai-form-section">
          <div class="ai-section-heading"><span>02</span><div><small>Investment preferences</small><h2>Define your investment lens.</h2><p>These preferences help us surface opportunities that fit your experience and cheque size.</p></div></div>
          <div class="ai-field ai-wide" data-choice-group data-multiple="true">
            <span>Sectors of interest * <small>select all that apply</small></span>
            <input name="sectors_of_interest" type="hidden" required />
            <div class="ai-choice-pills">{sectors.map(sector => <button type="button" data-value={sector} aria-pressed="false">{sector}</button>)}</div>
          </div>
          <div class="ai-field-grid">
            <label class="ai-field"><span>Typical ticket size *</span><select name="ticket_size" required><option value="" selected disabled>Select...</option><option>Under PKR 1M</option><option>PKR 1M – 2.5M</option><option>PKR 2.5M – 10M</option><option>PKR 10M – 25M</option><option>PKR 25M+</option></select></label>
            <label class="ai-field"><span>Preferred stage *</span><select name="preferred_stage" required><option value="" selected disabled>Select...</option><option>Idea / MVP</option><option>Early revenue</option><option>Growth</option><option>Any</option></select></label>
          </div>
          <div class="ai-field ai-wide" data-choice-group>
            <span>Angel investing experience *</span><input name="experience" type="hidden" required />
            <div class="ai-choice-cards">
              <button type="button" data-value="First-time" aria-pressed="false"><span>First-time</span><small>New to startup investing</small></button>
              <button type="button" data-value="Some deals" aria-pressed="false"><span>Some deals</span><small>1–5 investments made</small></button>
              <button type="button" data-value="Experienced" aria-pressed="false"><span>Experienced</span><small>5+ investments / fund</small></button>
            </div>
          </div>
          <label class="ai-field ai-wide"><span>How do you want to add value beyond capital? <small>optional — mentorship, network, industry expertise</small></span><textarea name="value_add" rows="5"></textarea></label>
        </section>

        <section class="ai-form-section ai-declarations">
          <div class="ai-section-heading"><span>03</span><div><small>Shared standards</small><h2>Protect the room.</h2><p>Two simple declarations keep founder information safe and the network credible.</p></div></div>
          <label class="ai-declaration"><input name="declaration_confidentiality" type="checkbox" required /><span><strong>Confidentiality agreement</strong><small>I will keep all startup data (financials, IP, plans) strictly confidential.</small></span></label>
          <label class="ai-declaration"><input name="declaration_source_of_funds" type="checkbox" required /><span><strong>Source-of-funds declaration</strong><small>I confirm the funds I intend to invest are from legitimate, lawful sources.</small></span></label>
        </section>

        <div class="ai-submit-row"><div><span>NEXT</span><p>Short verification call → investor onboarding → invitations to pitch events</p></div><button class="ai-submit" type="submit">Submit application <b>↗</b></button></div>
      </form>
    </div>

    <div class="ai-success" data-success-view hidden>
      <div class="ai-wrap">
        <div class="ai-success-card">
          <div class="ai-success-icon">✓</div>
          <h2>Application received</h2>
          <p>Reference no. <span class="ai-success-ref" data-ref-number></span> · Confirmation email sent. A member of our team will reach out within 5–7 working days to schedule a short verification call.</p>
          <a href="/">Back to home</a>
        </div>
      </div>
    </div>
  </section>
</FormShell>
