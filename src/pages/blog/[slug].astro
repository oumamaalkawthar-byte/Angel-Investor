---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="px-6 py-28">
    <div class="mx-auto max-w-3xl">
      <a href="/blog" class="text-sm text-accent transition-colors hover:text-paper">&larr; Blog</a>
      <p class="mt-6 font-mono text-xs text-paper/40">
        {post.data.author} &middot; {post.data.pubDate.toDateString()}
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">{post.data.title}</h1>
      {post.data.image && (
        <img
          src={post.data.image}
          alt=""
          class="mt-10 aspect-[16/9] w-full rounded-2xl object-cover"
        />
      )}
      <div class="mt-10 space-y-4 text-paper/80 [&_a]:text-accent [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-paper">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
