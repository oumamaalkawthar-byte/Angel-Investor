---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    title: 'Information We Collect',
    body: 'When you apply for funding, join as an investor, or contact us, we may collect your name, email, phone number, organization details, startup or investment information, pitch decks, financial projections, and other information you choose to submit through our forms.',
  },
  {
    title: 'How We Use Your Information',
    body: 'We use submitted information to review applications, screen startups, onboard investors, coordinate mentorship, communicate with you, and conduct due diligence. We do not use your information for purposes unrelated to these activities without your consent.',
  },
  {
    title: 'Confidentiality of Applications',
    body: 'Startup applications, pitch decks, financial projections, and investor details are treated as confidential. Access is limited to authorized team members and stakeholders directly involved in evaluation and decision-making.',
  },
  {
    title: 'Sharing of Information',
    body: 'We do not sell personal or business information. Information may be shared only when necessary for application review, investor matching, due diligence, legal compliance, or platform operations.',
  },
  {
    title: 'Data Security',
    body: 'We take reasonable technical and organizational measures to protect submitted information from unauthorized access, misuse, or disclosure. No online system can be guaranteed completely secure, and we encourage you to avoid sharing sensitive information beyond what a form requests.',
  },
  {
    title: 'Data Retention',
    body: 'We retain submitted information for as long as necessary for application review, communication, compliance, and record-keeping. You may contact us to request correction or removal of your information, subject to legal or operational requirements.',
  },
  {
    title: 'Cookies and Analytics',
    body: 'Our website may use cookies or analytics tools to understand visitor behavior and improve site performance.',
  },
  {
    title: 'Third-Party Links',
    body: 'Our website may contain links to third-party websites. We are not responsible for the privacy practices or content of external websites.',
  },
  {
    title: 'Changes to This Policy',
    body: 'We may update this Privacy Policy from time to time. Any changes will be published on this page.',
  },
  {
    title: 'Contact Us',
    body: 'For privacy-related questions or data requests, please reach out through our Contact page.',
  },
];
---

<BaseLayout title="Privacy Policy" description="How we collect, use, and protect your information.">
  <section class="px-6 py-28">
    <div class="mx-auto max-w-3xl">
      <p data-reveal class="mb-4 font-mono text-xs uppercase tracking-[0.3em] text-accent">Legal</p>
      <h1 data-reveal class="font-display text-4xl font-semibold sm:text-5xl">Privacy Policy</h1>
      <p data-reveal class="mt-6 text-paper/70">
        We respect your privacy and are committed to protecting the information shared through our
        website, startup applications, investor forms, and communication channels.
      </p>

      <div class="mt-14 space-y-10">
        {sections.map((section) => (
          <div data-reveal>
            <h2 class="font-display text-xl font-semibold">{section.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-paper/60">{section.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
