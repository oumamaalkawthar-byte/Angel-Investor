---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientBlob from '../components/GradientBlob.astro';
import OrganicBlob from '../components/OrganicBlob.astro';
import ScrollFrameSequence from '../components/ScrollFrameSequence.astro';
import StockMarket from '../components/StockMarket.astro';
import ScrollySteps from '../components/ScrollySteps.astro';
import EpisodeHighlights from '../components/EpisodeHighlights.astro';
import PitchMatch from '../components/PitchMatch.astro';
import { getCollection } from 'astro:content';

const portfolio = await getCollection('portfolio');
const featured = portfolio.filter((p) => p.data.featured);

const headline = 'Backing bold founders from day one.';

const stats = [
  { value: 42, suffix: '+', label: 'Companies Funded' },
  { value: 18, suffix: 'M+', prefix: '$', label: 'Capital Deployed' },
  { value: 250, suffix: 'K', prefix: '$', label: 'Average Check' },
  { value: 96, suffix: '%', label: 'Founder NPS' },
];

// Kept to the top band and the far bottom-right corner — the hero video
// now occupies the right-center column, so cards can't roam there anymore
// without overlapping it.
const explodeCards = [
  { label: 'Ezee Insure', value: 'PKR 25M raised', pos: 'top-[8%] left-[4%]' },
  { label: 'BlockLease', value: 'PKR 7M raised', pos: 'top-[8%] right-[4%]' },
  { label: 'Founder NPS', value: '96%', pos: 'bottom-[4%] right-[4%]' },
];
---

<BaseLayout title="Home">
  <section class="relative flex min-h-[90vh] flex-col justify-center overflow-hidden px-6" data-hero-explode>
    <GradientBlob />

    <div class="pointer-events-none absolute inset-0 z-0 hidden lg:block" aria-hidden="true">
      {explodeCards.map((card) => (
        <div data-explode-card class={`absolute ${card.pos} w-44 rounded-xl border border-line/60 bg-ink/90 px-4 py-3 shadow-2xl shadow-black/40 backdrop-blur`}>
          <p class="truncate text-xs text-paper/50">{card.label}</p>
          <p class="mt-1 font-mono text-lg font-semibold text-accent">{card.value}</p>
        </div>
      ))}
    </div>

    <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-col items-center gap-12 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
      <div class="w-full max-w-xl" data-hero-content>
        <p data-hero-fade class="mb-6 font-mono text-xs uppercase tracking-[0.3em] text-accent">
          Early-stage capital &middot; Hands-on partnership
        </p>
        <h1 class="font-display text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl">
          {headline.split(' ').map((word) => (
            <span class="inline-block overflow-hidden pb-2 align-bottom">
              <span data-hero-word class="inline-block">{word}&nbsp;</span>
            </span>
          ))}
        </h1>
        <p data-hero-fade class="mt-8 text-lg text-paper/70">
          We invest in early-stage startups with exceptional teams and big ideas —
          writing the first check and staying hands-on through every round after.
        </p>
        <div data-hero-fade class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="/apply-as-startup"
            data-magnetic
            class="inline-block rounded-full bg-cta px-8 py-4 font-medium text-ink transition-shadow hover:shadow-[0_0_40px_-8px_var(--color-cta)]"
          >
            Apply as Startup
          </a>
          <a
            href="/join-as-investor"
            data-magnetic
            class="inline-block rounded-full border border-paper/20 px-8 py-4 font-medium text-paper transition-colors hover:border-paper/50"
          >
            Join as Investor
          </a>
        </div>
        <p data-hero-fade class="mt-16 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-paper/30">
          <span class="inline-block h-4 w-px animate-pulse bg-paper/30"></span>
          Scroll to explore
        </p>
      </div>

      <div data-hero-fade class="w-56 flex-shrink-0 sm:w-64 lg:w-72">
        <div class="relative aspect-[9/16] overflow-hidden rounded-2xl border border-line/60 shadow-2xl shadow-black/50">
          <video
            src="/video/hero-bts.mp4"
            poster="/video/hero-bts-poster.jpg"
            autoplay
            muted
            loop
            playsinline
            class="h-full w-full object-cover"
          ></video>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/80 to-transparent px-4 pb-4 pt-10">
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-paper/70">Behind The Scenes</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <StockMarket />

  <section class="border-y border-line/60 bg-ink px-6 py-20">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-10 md:grid-cols-4">
      {stats.map((stat) => (
        <div data-reveal>
          <p class="font-mono text-4xl font-medium text-paper sm:text-5xl">
            {stat.prefix}<span data-counter={stat.value} data-counter-suffix={stat.suffix}>0{stat.suffix}</span>
          </p>
          <p class="mt-2 text-sm text-paper/60">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <ScrollFrameSequence
    framePath="/frames/network/frame-{n}.jpg"
    frameCount={80}
    captions={[
      { eyebrow: 'Our Network', text: 'Real founders. Real pitches.', from: 0.03, to: 0.28 },
      { eyebrow: 'Our Network', text: 'A network that listens.', from: 0.28, to: 0.55 },
      { eyebrow: 'Our Network', text: 'Ideas backed with capital.', from: 0.55, to: 0.8 },
      { eyebrow: 'Our Network', text: 'Every deal starts with the right connection.', from: 0.8, to: 0.97 },
    ]}
  />

  <section class="px-6 py-28">
    <div class="mx-auto max-w-6xl">
      <div data-reveal class="mb-14 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="font-display text-3xl font-semibold sm:text-4xl">Featured Portfolio</h2>
        <a href="/portfolio" class="text-sm text-accent transition-colors hover:text-paper">
          View all companies &rarr;
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((company) => (
          <a
            href={`/portfolio/${company.id}`}
            data-reveal
            class="group block rounded-2xl border border-line/60 bg-white/[0.02] p-8 transition-colors hover:border-accent/50"
          >
            <p class="font-display text-xl font-semibold">{company.data.company}</p>
            <p class="mt-2 text-sm text-paper/50">{company.data.industry} &middot; {company.data.stage}</p>
            <p class="mt-4 text-sm text-paper/70">{company.data.summary}</p>
            <span class="mt-6 inline-block text-sm text-accent opacity-0 transition-opacity group-hover:opacity-100">
              Read more &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <EpisodeHighlights />

  <PitchMatch />

  <ScrollySteps />

  <section class="relative overflow-hidden px-6 py-28">
    <OrganicBlob class="absolute -bottom-16 left-[6%] h-48 w-72 opacity-[0.1] blur-3xl" flip />
    <div data-reveal class="relative mx-auto flex max-w-4xl flex-col items-center gap-8 rounded-3xl border border-line/60 bg-gradient-to-br from-accent/15 to-cta/10 px-8 py-16 text-center">
      <h2 class="font-display text-3xl font-semibold sm:text-4xl">Have something bold to build?</h2>
      <p class="max-w-md text-paper/70">
        We read every application. If it's a fit, you'll hear from us within 48 hours.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/apply-as-startup"
          data-magnetic
          class="inline-block rounded-full bg-cta px-8 py-4 font-medium text-ink transition-shadow hover:shadow-[0_0_40px_-8px_var(--color-cta)]"
        >
          Apply as Startup
        </a>
        <a
          href="/join-as-investor"
          data-magnetic
          class="inline-block rounded-full border border-paper/20 px-8 py-4 font-medium text-paper transition-colors hover:border-paper/50"
        >
          Join as Investor
        </a>
      </div>
    </div>
  </section>

  <script src="../scripts/hero-explode.ts"></script>
</BaseLayout>
