---
// Homepage teaser widget — illustrative directional math only. The
// validated Berkus / Revenue Multiple calculator lives at
// /valuation-calculator (src/scripts/valuation-calculator.ts); this widget
// links out to it rather than duplicating its formulas.
---

<section id="valuation" data-valuation class="bg-cta py-28 lg:py-36">
  <div class="wrap">
    <div class="section-intro">
      <div><p class="eyebrow text-ink">Startup valuation calculator</p><h2>Know your range.<br /><em>See what drives it.</em></h2></div>
      <p>Move beyond a single number. Explore how stage, traction and funding ask shape your indicative valuation and ownership.</p>
    </div>

    <div class="mt-16 grid overflow-hidden rounded-[26px] bg-white shadow-[0_32px_80px_rgba(7,27,42,.2)] lg:grid-cols-[.8fr_1.2fr]">
      <div class="border-b border-navy/10 p-6 md:p-9 lg:border-b-0 lg:border-r">
        <div>
          <label class="text-[10px] font-bold uppercase tracking-[.12em] text-muted">Business stage</label>
          <div class="mt-3 grid grid-cols-3 rounded-xl bg-[#edf1f3] p-1">
            {['Pre-revenue', 'Early revenue', 'Growth'].map((name, index) => <button data-stage={index} class:list={["rounded-lg px-2 py-3 text-[9px] font-bold transition", index === 1 ? "bg-deep text-white" : "text-ink/55"]}>{name}</button>)}
          </div>
        </div>

        <div class="mt-9">
          <label class="flex justify-between text-xs"><span>Traction strength</span><b data-traction-output>62%</b></label>
          <input data-traction class="mt-4 w-full accent-cta" aria-label="Traction strength" type="range" min="15" max="100" value="62" />
          <small class="mt-2 block text-[9px] leading-4 text-muted">Team, product readiness, customer signals and market access</small>
        </div>

        <div class="mt-8">
          <label class="flex justify-between text-xs"><span>Funding ask</span><b data-raise-output>PKR 15M</b></label>
          <input data-raise class="mt-4 w-full accent-cta" aria-label="Funding ask" type="range" min="2" max="50" value="15" />
          <small class="mt-2 block text-[9px] leading-4 text-muted">Indicative amount for the next investment round</small>
        </div>

        <div class="mt-8 flex gap-3 rounded-xl bg-[#f5f6f6] p-4 text-[10px] leading-5 text-muted"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-[9px] text-white">i</span><p>Illustrative estimate for early conversations. Use the full calculator for the Berkus / Revenue Multiple methodology.</p></div>
        <a class="mt-6 flex justify-between border-t border-navy/10 pt-5 text-xs font-bold" href="/valuation-calculator">Open full calculator <span>↗</span></a>
      </div>

      <div class="bg-deep p-6 text-white md:p-9">
        <div class="flex flex-wrap items-start justify-between gap-7 border-b border-white/10 pb-7">
          <div><small class="text-[8px] font-bold tracking-[.15em] text-white/35">INDICATIVE VALUATION</small><strong class="mt-2 block text-[clamp(38px,5vw,68px)] tracking-[-.07em]">PKR <span data-mid>68</span><i class="text-xl not-italic text-cta">M</i></strong><p data-range-output class="text-[10px] text-white/40">Estimated range PKR 53M – 86M</p></div>
          <div data-signal-ring class="signal-ring flex h-28 w-28 items-center justify-center rounded-full p-2">
            <div class="flex h-full w-full flex-col items-center justify-center rounded-full bg-deep"><span data-signal class="text-sm font-bold text-cta">Promising</span><small class="mt-1 text-[6px] tracking-[.12em] text-white/35">VALUATION SIGNAL</small></div>
          </div>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <article class="rounded-2xl border border-white/10 bg-white/[.035] p-5">
            <div class="flex justify-between"><span class="text-xs font-bold">Value drivers</span><small class="text-[7px] tracking-[.12em] text-white/30">RELATIVE STRENGTH</small></div>
            <svg class="mx-auto mt-2 h-[235px] w-full" viewBox="0 0 200 200" aria-label="Startup value driver radar chart">
              <g fill="none" stroke="rgba(255,255,255,.12)"><polygon points="100,24 172,76 145,162 55,162 28,76"/><polygon points="100,54 144,86 127,138 73,138 56,86"/><line x1="100" y1="100" x2="100" y2="24"/><line x1="100" y1="100" x2="172" y2="76"/><line x1="100" y1="100" x2="145" y2="162"/><line x1="100" y1="100" x2="55" y2="162"/><line x1="100" y1="100" x2="28" y2="76"/></g>
              <polygon data-radar points="100,44 151,83 129,140 69,142 52,84" fill="rgba(252,189,23,.24)" stroke="#fcbd17" stroke-width="2" />
            </svg>
            <div class="flex justify-between text-[8px] text-white/35"><span>Team</span><span>Market</span><span>Traction</span><span>Product</span><span>Growth</span></div>
          </article>

          <article class="rounded-2xl border border-white/10 bg-white/[.035] p-5">
            <div class="flex justify-between"><span class="text-xs font-bold">Post-money ownership</span><small class="text-[7px] tracking-[.12em] text-white/30">ESTIMATED</small></div>
            <div class="mt-6 flex flex-col items-center gap-5 xl:flex-row">
              <div data-donut class="flex h-36 w-36 shrink-0 items-center justify-center rounded-full"><div class="flex h-[98px] w-[98px] flex-col items-center justify-center rounded-full bg-deep"><b data-founder-main class="text-2xl">82%</b><small class="text-[7px] text-white/35">FOUNDERS</small></div></div>
              <div class="w-full text-[10px]">
                <p class="grid grid-cols-[12px_1fr_auto] gap-2 border-b border-white/10 py-3"><i class="mt-1 h-2 w-2 rounded-full bg-cta"></i><span>Founders</span><b data-founder>82%</b></p>
                <p class="grid grid-cols-[12px_1fr_auto] gap-2 border-b border-white/10 py-3"><i class="mt-1 h-2 w-2 rounded-full bg-[#315069]"></i><span>New investors</span><b data-investor>18%</b></p>
                <small data-ownership-note class="mt-4 block leading-4 text-white/30">Based on PKR 15M raised against the estimated valuation.</small>
              </div>
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initValuationPreview() {
    const root = document.querySelector<HTMLElement>("[data-valuation]");
    if (!root) return;

    const stageButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-stage]")];
    const tractionInput = root.querySelector<HTMLInputElement>("[data-traction]");
    const raiseInput = root.querySelector<HTMLInputElement>("[data-raise]");
    let stage = 1;

    const text = (selector: string, value: string) => { const el = root.querySelector<HTMLElement>(selector); if (el) el.textContent = value; };
    const update = () => {
      const traction = Number(tractionInput?.value ?? 62);
      const raise = Number(raiseInput?.value ?? 15);
      const base = [18, 42, 85][stage];
      const mid = Math.round((base + traction * .42) * 10) / 10;
      const low = Math.round(mid * .78);
      const high = Math.round(mid * 1.27);
      const investor = Math.min(38, Math.round(raise / (mid + raise) * 100));
      const founder = 100 - investor;
      const points = [22 + traction * .42, 30 + stage * 21, 42 + traction * .34, 34 + stage * 18, 27 + traction * .45];
      const radarPoints = points.map((value, index) => { const angle = (-90 + index * 72) * Math.PI / 180; return `${100 + Math.cos(angle) * value},${100 + Math.sin(angle) * value}`; }).join(" ");

      text("[data-traction-output]", `${traction}%`);
      text("[data-raise-output]", `PKR ${raise}M`);
      text("[data-mid]", String(mid));
      text("[data-range-output]", `Estimated range PKR ${low}M – ${high}M`);
      text("[data-signal]", traction < 45 ? "Developing" : traction < 75 ? "Promising" : "Strong");
      text("[data-founder-main]", `${founder}%`);
      text("[data-founder]", `${founder}%`);
      text("[data-investor]", `${investor}%`);
      text("[data-ownership-note]", `Based on PKR ${raise}M raised against the estimated valuation.`);
      root.querySelector<SVGPolygonElement>("[data-radar]")?.setAttribute("points", radarPoints);
      const donut = root.querySelector<HTMLElement>("[data-donut]");
      if (donut) donut.style.background = `conic-gradient(#fcbd17 0 ${founder}%, #315069 ${founder}% 100%)`;
      const ring = root.querySelector<HTMLElement>("[data-signal-ring]");
      if (ring) ring.style.background = `conic-gradient(#fcbd17 0 ${Math.min(92, 35 + traction * .55)}%, rgba(255,255,255,.1) 0)`;
    };

    const stageHandler = (button: HTMLButtonElement) => {
      stage = Number(button.dataset.stage ?? 1);
      stageButtons.forEach((item, index) => item.className = `rounded-lg px-2 py-3 text-[9px] font-bold transition ${index === stage ? "bg-deep text-white" : "text-ink/55"}`);
      update();
    };
    stageButtons.forEach((button) => button.addEventListener("click", () => stageHandler(button)));
    tractionInput?.addEventListener("input", update);
    raiseInput?.addEventListener("input", update);
    update();
  }

  document.addEventListener("astro:page-load", initValuationPreview);
</script>
