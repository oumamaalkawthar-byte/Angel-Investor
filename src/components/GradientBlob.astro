---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`pointer-events-none absolute inset-0 -z-10 overflow-hidden ${className}`} aria-hidden="true">
  <div
    class="absolute -top-32 left-[10%] h-80 w-80 rounded-full bg-accent/40 blur-[90px] sm:-top-40 sm:left-1/4 sm:h-[32rem] sm:w-[32rem] sm:blur-[120px]"
  >
  </div>
  <div
    class="absolute top-1/4 -right-16 h-64 w-64 rounded-full bg-cta/30 blur-[80px] sm:top-1/3 sm:-right-20 sm:h-[24rem] sm:w-[24rem] sm:blur-[110px]"
  >
  </div>
</div>
