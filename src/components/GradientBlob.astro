---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`pointer-events-none absolute inset-0 -z-10 overflow-hidden ${className}`} aria-hidden="true">
  <div
    class="absolute -top-40 left-1/4 h-[32rem] w-[32rem] rounded-full bg-accent/30 blur-[120px]"
  >
  </div>
  <div
    class="absolute top-1/3 -right-20 h-[24rem] w-[24rem] rounded-full bg-cta/20 blur-[110px]"
  >
  </div>
</div>
