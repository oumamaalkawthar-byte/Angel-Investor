---
const year = new Date().getFullYear();
const links = [
  { label: 'About', href: '/about' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Market Insights', href: '/market-insights' },
  { label: 'Blog', href: '/blog' },
  { label: 'Apply as Startup', href: '/apply-as-startup' },
  { label: 'Join as Investor', href: '/join-as-investor' },
  { label: 'Valuation Calculator', href: '/valuation-calculator' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="border-t border-white/10 bg-deep">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div>
        <img src="/logo-white.png" alt="Angel Investor" class="h-8 w-auto" />
        <p class="mt-4 max-w-xs text-sm text-white/50">
          Backing bold founders from day one.
        </p>
      </div>
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {links.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-white/60 transition-colors hover:text-white">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-xs text-white/35">&copy; {year} Angel Investor. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy-policy" class="text-xs text-white/35 transition-colors hover:text-white/70">Privacy Policy</a>
        <a href="/terms-and-conditions" class="text-xs text-white/35 transition-colors hover:text-white/70">Terms and Conditions</a>
      </div>
    </div>
  </div>
</footer>
