---
const year = new Date().getFullYear();
const links = [
  { label: 'About', href: '/about' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Team', href: '/team' },
  { label: 'Blog', href: '/blog' },
  { label: 'Apply', href: '/apply' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="border-t border-line/60 bg-ink">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="font-display text-lg font-semibold text-paper">Angel Investor</p>
        <p class="mt-2 max-w-xs text-sm text-paper/60">
          Backing bold founders from day one.
        </p>
      </div>
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {links.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-paper/60 transition-colors hover:text-paper">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <p class="mt-12 font-mono text-xs text-paper/40">&copy; {year} Angel Investor. All rights reserved.</p>
  </div>
</footer>
