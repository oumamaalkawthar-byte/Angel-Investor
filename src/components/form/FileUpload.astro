---
interface Props {
  label: string;
  name: string;
  hint?: string;
  accept?: string;
  required?: boolean;
}

const { label, name, hint, accept = '.pdf', required = false } = Astro.props;
---

<div class="field">
  <label class="mb-2 block text-sm font-medium text-paper/80">
    {label} {required && <span class="text-cta">*</span>}
  </label>
  <label
    for={name}
    data-file-drop
    class="flex cursor-pointer flex-col items-center gap-1.5 rounded-xl border border-dashed border-line/60 px-6 py-8 text-center transition-colors hover:border-accent/50"
  >
    <span data-file-label class="text-sm font-medium text-paper">Drop your pitch deck here, or click to browse</span>
    {hint && <span class="text-xs text-paper/40">{hint}</span>}
    <input id={name} name={name} type="file" accept={accept} required={required} class="sr-only" data-file-input />
  </label>
</div>
