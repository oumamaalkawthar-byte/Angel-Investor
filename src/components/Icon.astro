---
interface Props {
  name: 'send' | 'search' | 'rocket' | 'users' | 'bolt' | 'infinity';
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;

const paths: Record<Props['name'], string[]> = {
  send: ['M25 3 13 15', 'M25 3 17 25l-4-9-9-4 21-9z'],
  search: ['M13 22a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z', 'M25 25l-6.35-6.35'],
  rocket: ['M14 3l2.4 6.2L23 12l-6.6 2.8L14 21l-2.4-6.2L5 12l6.6-2.8L14 3Z'],
  users: ['M11 14a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z', 'M5 25c1-4 3-6 6-6s5 2 6 6', 'M19 8a4 4 0 0 1 0 8', 'M19 19c3 0 5 2 6 6'],
  bolt: ['M17 3 6 17h8l-2 10 11-14h-8l2-10Z'],
  infinity: [
    'M9 14a5 5 0 1 0 0 6 12 12 0 0 1 8-6 5 5 0 1 1 0 6 12 12 0 0 0-8-6Z',
  ],
};
---

<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {paths[name].map((d) => <path d={d} data-line-draw />)}
</svg>
