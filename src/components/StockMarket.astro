---
---

<section class="border-y border-line/60 bg-white/[0.02] py-10" data-stock-market>
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-accent">Market Pulse &middot; PSX</p>
      <div class="relative w-full max-w-xs" data-stock-search-root>
        <input
          type="text"
          placeholder="Search a stock — e.g. LUCK, HBL"
          data-stock-search
          autocomplete="off"
          class="w-full rounded-full border border-line/60 bg-ink px-4 py-2.5 text-sm text-paper placeholder:text-paper/30 outline-none transition-colors focus:border-accent"
        />
        <div
          data-stock-search-results
          class="hidden absolute z-30 mt-2 max-h-72 w-full overflow-auto rounded-xl border border-line/60 bg-[#0d1220] p-1.5 shadow-2xl shadow-black/40"
        >
        </div>
      </div>
    </div>

    <!-- Ticker marquee -->
    <div class="group relative mb-8 overflow-hidden">
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-ink to-transparent"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-ink to-transparent"></div>
      <div data-stock-ticker class="flex w-max gap-3 animate-stock-marquee group-hover:[animation-play-state:paused]">
        <p class="px-5 py-3 text-sm text-paper/40">Loading live prices&hellip;</p>
      </div>
    </div>

    <!-- Selected-stock chart panel -->
    <div class="rounded-2xl border border-line/60 bg-ink p-6" data-stock-panel>
      <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="font-mono text-xs uppercase tracking-wide text-paper/40" data-stock-panel-symbol>&mdash;</p>
          <p class="font-display text-2xl font-semibold" data-stock-panel-name>Loading&hellip;</p>
        </div>
        <div class="text-right">
          <p class="font-mono text-2xl font-semibold" data-stock-panel-price>&mdash;</p>
          <p class="text-sm text-paper/40" data-stock-panel-change>&nbsp;</p>
        </div>
      </div>

      <div class="h-64 w-full" data-stock-panel-chart></div>

      <div class="mt-5 grid grid-cols-2 gap-4 border-t border-line/60 pt-4 text-sm sm:grid-cols-4" data-stock-panel-stats></div>
    </div>

    <p class="mt-4 text-xs text-paper/30">
      Live data from the Pakistan Stock Exchange trading board, refreshed every few minutes. For informational purposes only — not investment advice.
    </p>
  </div>
</section>

<script src="../scripts/stock-market.ts"></script>

<style>
  @keyframes stock-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .animate-stock-marquee {
    animation: stock-marquee 40s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-stock-marquee {
      animation: none;
    }
  }
</style>
