---
interface Episode {
  ep: string;
  hook: string;
  company: string;
  deal: string;
  videoId: string;
}

const episodes: Episode[] = [
  { ep: 'Episode 7', hook: 'Can They Agree?', company: 'Ezee Insure', deal: 'PKR 25M for 4% equity', videoId: 'ytiuJ1nhh0g' },
  { ep: 'Episode 6', hook: 'Did The Pitch Impress Them?', company: 'BlockLease', deal: 'PKR 7M for 5% equity', videoId: 'TUVOdzD6O80' },
  { ep: 'Episode 5', hook: 'Will They Make A Deal?', company: 'Fulflit', deal: '$50,000 for 10% equity', videoId: 'pWoLe8wa2NA' },
  { ep: 'Episode 4', hook: 'Investors Said Yes', company: 'Confidential', deal: 'PKR 15M for 20% equity', videoId: 'zvIE2FzfHoI' },
  { ep: 'Episode 3', hook: 'Will They Invest?', company: 'Agrogen Realis Nitro', deal: 'PKR 5 crore investment ask', videoId: '8zPS9dMvkjY' },
  { ep: 'Episode 2', hook: 'Deal Or No Deal?', company: 'Aitisal', deal: '$150,000 for 15% equity', videoId: '2u1AY8wMjG0' },
  { ep: 'Episode 1', hook: 'Can Board Spy Secure It?', company: 'Board Spy', deal: '$100,000 investment ask', videoId: 'dFTzEBqWQGU' },
];

const channelUrl = 'https://www.youtube.com/@angelinvestoroffical';
const watchUrl = (id: string) => `https://www.youtube.com/watch?v=${id}`;
const thumbUrl = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<section class="border-t border-line/60 px-6 py-28">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="mb-14 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.3em] text-accent">From The Show</p>
        <h2 class="font-display text-3xl font-semibold sm:text-4xl">Real pitches. Real decisions.</h2>
      </div>
      <a href={channelUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-accent transition-colors hover:text-paper">
        Watch on YouTube &rarr;
      </a>
    </div>

    <div class="-mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-4">
      {episodes.map((episode) => (
        <a
          href={watchUrl(episode.videoId)}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          class="group w-72 flex-shrink-0 snap-start overflow-hidden rounded-2xl border border-line/60 bg-white/[0.02] transition-colors hover:border-accent/50"
        >
          <div class="relative aspect-video overflow-hidden bg-ink">
            <img
              src={thumbUrl(episode.videoId)}
              alt={`${episode.ep}: ${episode.hook}`}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <div class="absolute inset-0 flex items-center justify-center bg-ink/20 opacity-0 transition-opacity group-hover:opacity-100">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-cta text-ink shadow-lg">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M3 1.5v13l11-6.5-11-6.5z" /></svg>
              </span>
            </div>
          </div>
          <div class="p-6">
            <p class="font-mono text-xs uppercase tracking-wide text-accent">{episode.ep}</p>
            <p class="mt-2 font-display text-xl font-semibold leading-tight">{episode.hook}</p>
            <p class="mt-4 text-sm text-paper/50">{episode.company}</p>
            <p class="mt-1 font-mono text-sm text-paper/80">{episode.deal}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
