---
interface Episode {
  ep: string;
  hook: string;
  company: string;
  deal: string;
}

const episodes: Episode[] = [
  { ep: 'Episode 7', hook: 'Can They Agree?', company: 'Ezee Insure', deal: 'PKR 25M for 4% equity' },
  { ep: 'Episode 6', hook: 'Did The Pitch Impress Them?', company: 'BlockLease', deal: 'PKR 7M for 5% equity' },
  { ep: 'Episode 5', hook: 'Will They Make A Deal?', company: 'Fulflit', deal: '$50,000 for 10% equity' },
  { ep: 'Episode 4', hook: 'Investors Want In!', company: 'Confidential', deal: 'PKR 15M for 20% equity' },
  { ep: 'Episode 3', hook: 'Will They Invest?', company: 'Agrogen Realis Nitro', deal: 'PKR 5 crore investment ask' },
  { ep: 'Episode 2', hook: 'Deal Or No Deal?', company: 'Aitisal', deal: '$150,000 for 15% equity' },
];

const channelUrl = 'https://www.youtube.com/@angelinvestoroffical';
---

<section class="border-t border-line/60 px-6 py-28">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="mb-14 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.3em] text-accent">From The Show</p>
        <h2 class="font-display text-3xl font-semibold sm:text-4xl">Real pitches. Real decisions.</h2>
      </div>
      <a href={channelUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-accent transition-colors hover:text-paper">
        Watch on YouTube &rarr;
      </a>
    </div>

    <div class="-mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-4">
      {episodes.map((episode) => (
        <a
          href={channelUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          class="group w-72 flex-shrink-0 snap-start rounded-2xl border border-line/60 bg-white/[0.02] p-7 transition-colors hover:border-accent/50"
        >
          <p class="font-mono text-xs uppercase tracking-wide text-accent">{episode.ep}</p>
          <p class="mt-3 font-display text-2xl font-semibold leading-tight">{episode.hook}</p>
          <p class="mt-5 text-sm text-paper/50">{episode.company}</p>
          <p class="mt-1 font-mono text-sm text-paper/80">{episode.deal}</p>
          <span class="mt-6 inline-block text-sm text-accent opacity-0 transition-opacity group-hover:opacity-100">
            Watch episode &rarr;
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
