---
interface Props {
  label: string;
  symbol: string;
  description: string;
}

const { label, symbol, description } = Astro.props;
const tvUrl = `https://www.tradingview.com/symbols/${symbol.replace(':', '-')}/`;
---

<a
  href={tvUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-reveal
  class="group flex flex-col justify-between rounded-2xl border border-line/60 bg-white/[0.02] p-6 transition-colors hover:border-accent/50"
>
  <div>
    <p class="font-mono text-xs uppercase tracking-wide text-paper/40">{symbol}</p>
    <p class="mt-1 font-display text-lg font-semibold text-paper">{label}</p>
    <p class="mt-2 text-sm text-paper/60">{description}</p>
  </div>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm text-accent">
    View live chart on TradingView
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
      <path d="M4 10L10 4M10 4H5M10 4V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>
