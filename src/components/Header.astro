---
const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Market Insights', href: '/market-insights' },
  { label: 'Blog', href: '/blog' },
  { label: 'Join as Investor', href: '/join-as-investor' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-ink/70 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-paper">
      <span class="inline-block h-2 w-2 rounded-full bg-accent"></span>
      Angel Investor
    </a>
    <ul class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-sm text-paper/70 transition-colors hover:text-paper"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-3">
      <a
        href="/apply-as-startup"
        class="hidden rounded-full bg-cta px-5 py-2 text-sm font-medium text-ink transition-transform hover:scale-105 sm:inline-block"
      >
        Apply as Startup
      </a>
      <button
        type="button"
        id="nav-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-paper/20 text-paper md:hidden"
      >
        <svg id="nav-icon-open" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 4H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M1 9H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M1 14H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <svg id="nav-icon-close" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="hidden">
          <path d="M1 1L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M15 1L1 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-nav"
    class="pointer-events-none absolute inset-x-0 top-full max-h-0 overflow-hidden border-b border-line/60 bg-ink/95 backdrop-blur-md transition-[max-height] duration-300 ease-out md:hidden"
  >
    <ul class="flex flex-col gap-1 px-6 py-4">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="block rounded-lg px-3 py-3 text-base text-paper/80 transition-colors hover:bg-white/5 hover:text-paper"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href="/apply-as-startup"
          class="block rounded-full bg-cta px-5 py-3 text-center text-sm font-medium text-ink"
        >
          Apply as Startup
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  function initNavToggle() {
    const toggle = document.getElementById('nav-toggle');
    const panel = document.getElementById('mobile-nav');
    const iconOpen = document.getElementById('nav-icon-open');
    const iconClose = document.getElementById('nav-icon-close');
    if (!toggle || !panel || !iconOpen || !iconClose) return;

    const close = () => {
      panel.classList.remove('pointer-events-auto');
      panel.classList.add('pointer-events-none');
      panel.style.maxHeight = '0px';
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    };

    const open = () => {
      panel.classList.add('pointer-events-auto');
      panel.classList.remove('pointer-events-none');
      panel.style.maxHeight = panel.scrollHeight + 'px';
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? close() : open();
    });

    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
  }

  document.addEventListener('astro:page-load', initNavToggle);
</script>
