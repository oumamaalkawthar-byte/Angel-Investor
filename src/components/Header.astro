---
const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Team', href: '/team' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-ink/70 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-paper">
      <span class="inline-block h-2 w-2 rounded-full bg-accent"></span>
      Angel Investor
    </a>
    <ul class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-sm text-paper/70 transition-colors hover:text-paper"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href="/apply"
      class="rounded-full bg-cta px-5 py-2 text-sm font-medium text-ink transition-transform hover:scale-105"
    >
      Apply
    </a>
  </nav>
</header>
