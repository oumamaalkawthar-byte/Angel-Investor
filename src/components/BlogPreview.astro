---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const displayDate = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<section class="overflow-hidden bg-ink py-28">
  <div class="wrap mb-14 flex flex-col gap-4 px-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="eyebrow">From the blog</p>
      <h2 class="mt-3 font-display text-3xl font-semibold sm:text-4xl">Ideas worth reading.</h2>
    </div>
    <a href="/blog" class="text-sm text-accent transition-colors hover:text-paper">
      View all articles &rarr;
    </a>
  </div>

  <div class="blog-marquee" data-blog-marquee>
    <div class="blog-marquee-track">
      {[...posts, ...posts].map((post, i) => (
        <a
          href={`/blog/${post.id}`}
          class="blog-marquee-card group block flex-none overflow-hidden rounded-2xl border border-line/60 bg-white/[0.02] transition-colors hover:border-accent/50"
          aria-hidden={i >= posts.length ? "true" : undefined}
          tabindex={i >= posts.length ? -1 : undefined}
        >
          <div class="aspect-video w-full overflow-hidden bg-navy">
            {(post.data.art ?? 'photo') === 'photo' && post.data.image ? (
              <img src={post.data.image} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-[linear-gradient(145deg,#0b2940,#071b2a)]">
                <span class="font-display text-2xl font-semibold text-accent/70">{post.data.category}</span>
              </div>
            )}
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.18em] text-paper/40">
              <span>{post.data.category}</span>
              <span>{post.data.readTime}</span>
            </div>
            <h3 class="mt-3 font-display text-lg font-semibold leading-snug">{post.data.title}</h3>
            <p class="mt-2 text-sm text-paper/50">{displayDate(post.data.pubDate)}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .blog-marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .blog-marquee-track {
    display: flex;
    width: max-content;
    gap: 24px;
    padding-inline: 24px;
    animation: blog-marquee-scroll 48s linear infinite;
  }
  .blog-marquee:hover .blog-marquee-track,
  .blog-marquee:focus-within .blog-marquee-track {
    animation-play-state: paused;
  }
  .blog-marquee-card {
    width: 30vw;
    min-width: 280px;
    max-width: 400px;
  }
  @keyframes blog-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (max-width: 900px) {
    .blog-marquee-card { width: 60vw; }
  }
  @media (max-width: 640px) {
    .blog-marquee-card { width: 82vw; min-width: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-marquee-track { animation: none; width: auto; flex-wrap: wrap; }
    .blog-marquee { overflow-x: auto; }
    .blog-marquee-card[aria-hidden="true"] { display: none; }
  }
</style>
