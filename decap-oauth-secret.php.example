<?php
/**
 * Template for the Decap CMS GitHub OAuth App credentials.
 *
 * This file itself is never deployed — only public/ gets copied into dist/
 * and pushed to the deploy branch, so it's the wrong repo to hold a secret
 * in anyway (it's on GitHub, which may be public).
 *
 * One-time setup on the live server:
 *   1. Copy this file to: ~/decap-oauth-secret.php
 *      (i.e. one level above public_html — NOT inside public_html, and
 *      NOT inside the new.angelinvestor.pk site folder. That keeps it
 *      outside anything a browser can ever reach.)
 *   2. Create a GitHub OAuth App at https://github.com/settings/developers
 *        Homepage URL:            https://new.angelinvestor.pk
 *        Authorization callback:  https://new.angelinvestor.pk/api/decap-callback.php
 *   3. Paste its Client ID and Client Secret into the copy on the server.
 *   4. Visit https://new.angelinvestor.pk/admin and log in with GitHub.
 *
 * Only someone with write access to the oumamaalkawthar-byte/Angel-Investor
 * repo can actually save changes through the CMS — GitHub enforces that,
 * this app just brokers the login.
 */
return [
    'client_id' => 'PASTE_GITHUB_OAUTH_CLIENT_ID_HERE',
    'client_secret' => 'PASTE_GITHUB_OAUTH_CLIENT_SECRET_HERE',
];
